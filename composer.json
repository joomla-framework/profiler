{
    "name": "joomla/profiler",
    "type": "joomla-package",
    "description": "Joomla Profiler Package",
    "keywords": ["joomla", "framework", "profiler"],
    "homepage": "https://github.com/joomla-framework/profiler",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0"
    },
    "require-dev": {
        "joomla/test": "^4.0",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "~3.10.2",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Profiler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Profiler\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "dev"
}
